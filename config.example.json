{
  "cluster": "dev-apps-cluster",
  "services": [
    {
      "name": "orders-api",
      "health_check_url": "https://api.example.com/health"
    },
    {
      "name": "payments-api",
      "health_check_url": "https://payments.example.com/health",
      "critical": true
    }
  ],
  "region": "us-east-1",
  "expected_account_id": "123456789012",
  "checks": {
    "include_http_health": true,
    "http_expected_status": 200,
    "http_health_path": "/health",
    "http_timeout_seconds": 5
  },
  "notifications": {
    "on_fail": true,
    "on_warn": false,
    "slack_webhook_url": "https://hooks.slack.com/services/REPLACE/ME",
    "webhook_url": "",
    "sns_topic_arn": ""
  }
}
